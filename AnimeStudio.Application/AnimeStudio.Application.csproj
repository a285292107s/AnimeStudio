<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AnimeStudio.Application</RootNamespace>
  </PropertyGroup>

  <!--
    Headless application layer: no WinForms, no OpenTK, no FMOD, no native DLLs.
    Everything here must be runnable from a console app and unit-testable.
  -->

</Project>
